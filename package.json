{
  "name": "nacos-desktop",
  "version": "1.0.0",
  "description": "Nacos Desktop Manager - 跨平台 Nacos 版本管理与启动工具",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && node scripts/build-win.js",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "build:all": "npm run build && node scripts/build-win.js",
    "icon": "electron-icon-builder --input=resources/icon.png --output=resources/"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.6.7",
    "codemirror": "^6.0.2",
    "electron-log": "^5.1.1",
    "electron-store": "^8.1.0",
    "pinia": "^2.1.7",
    "sql.js": "^1.10.2",
    "vue": "^3.4.19",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/codemirror": "^5.60.17",
    "@types/node": "^20.11.19",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^28.2.3",
    "electron-builder": "^24.12.0",
    "electron-icon-builder": "^2.0.1",
    "electron-vite": "^2.0.0",
    "element-plus": "^2.6.0",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vue-tsc": "^1.8.27"
  },
  "build": {
    "appId": "com.nacos.desktop",
    "productName": "Nacos Desktop Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "asar": true,
    "asarUnpack": "resources/**/*",
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
      "sign": null
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Development",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nacos Desktop Manager"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "dmg": {
      "title": "${productName}",
      "window": {
        "width": 600,
        "height": 400
      }
    }
  }
}
